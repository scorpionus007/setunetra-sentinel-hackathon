# API auth — HS256 signing secret for JWTs (set a strong value in production)
API_SECRET_KEY=changeme
# API_RATE_LIMIT_PER_MIN=600
# API_TOKEN_TTL=28800

# Live ingest (no ML) — decodes each camera's rtsp_url to a JPEG snapshot.
